
def f(a):
    s = ''
    while a > 1:
        s += str(a % 2)
        a = a // 2
    s += str(a)
    return s[::-1]

def x(a):
    s = ''
    while a > 7:
        s += str(a % 8)
        a = a // 8
    s += str(a)
    return s[::-1]

def g(a):
    s = ''
    while a > 15:
        s += str(a % 16)
        a = a // 16
    s += str(a)
    return s[::-1]

a = int(input())
print(f(a), x(a), g(a))
