students = [
    ("Иван", 25, 4.5),
    ("Мария", 22, 4.8),
    ("Пётр", 30, 4.2),
    ("Анна", 20, 4.9)
]

# Самый старший
oldest = max(students, key=lambda s: s)
print(f"Самый старший: {oldest}, {oldest} лет")
# С самым высоким баллом
best = max(students, key=lambda s: s)
print(f"Лучший студент: {best}, балл {best}")
# Средний возраст
avg_age = sum(s[1] for s in students) / len(students)
print(f"Средний возраст: {avg_age:.1f}")
# Сортировка по баллу (убывание)
sorted_students = sorted(students, key=lambda s: s, reverse=True)
print("\nПо баллу:")
for name, age, gpa in sorted_students:
    print(f"{name}: {gpa}")
