a = float(input('введите первое число: '))
b = float(input('введите второе число: '))
op = input('введите операцию (+, -, *, /): ').strip()

match op:
    case '+':
        print('Результат: ', a + b)
    case '-':
        print('Результат: ',a - b)
    case '*':
        print('Результат: ',a * b)
    case '/':
        if b == 0.0:
            print('Ошибка: деление на ноль')
        else:
            print('Результат: ',a / b)
    case _:
        print('неизвестная операция')
