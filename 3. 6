print('конвертер температур')
print('1. из C в F')
print('2. из F в C')

ch = input('ваш выбор (1/2): ')

if ch == '1':
    C = float(input('введите температуру по C: '))
    f = C * 9 / 5 + 32
    print('C =', C, 'F =', f)
elif ch == '2':
    F = float(input('введите температуру по F: '))
    C = (F - 32) * 5 / 9
    print('F =', F, 'C =', C)
else:
    print('некорректный выбор')
